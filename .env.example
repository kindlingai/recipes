# Copy to .env next to compose.yaml on both boxes, the same file on each. PEERS is required unless MENTAT=1: edit and
# uncomment it below. Unset, the other settings take the image's defaults (Dockerfile) and TUNE's (knobs.sh).

# --- the two boxes ------------------------------------------------------------------------------------------------
#PEERS=<head-lan-ip>,<box2-lan-ip>
#IPS=<head-root1-ip>,<box2-root1-ip>
#IPS2=<head-root2-ip>,<box2-root2-ip>

# --- the knobs (README.md, "Knobs") ---------------------------------------------------------------------------------
#TUNE=speed
#VARIANT=k4
#SESS=4
#CAP=262208
#MAX_MODEL_LEN=262144
#DFLASH=0
#MENTAT=0
#GROUP=gr8-sage-2x
# Text-only is the default. The release includes dense/vision-bf16.safetensors (1.13 GB, untested with this recipe).
# To opt in, set GR8_GLM53F_VISION=1 in EXTRA_ENV on both boxes:
#EXTRA_ENV="GR8_GLM53F_VISION=1"
#DEFAULT_MAX_TOKENS=32768
#DEFAULT_THINK_END_BOOST=
#DEFAULT_THINKING_BUDGET=0
#DEFAULT_PRESENCE_PENALTY=0
#UNDECLARED_TOOL_CALLS=emit

# --- host directories in place of the named volumes, each owned by uid 1000 ------------------------------------------
#MODEL_CACHE_DIR=/srv/sage-2x/cache      # this box's part of the model (~82 GiB at TP=2)
#PROMPT_CACHE_DIR=/srv/sage-2x/prompts   # the prompt cache, up to 64 GB (kv-store.yaml)
#GR8_HOME_DIR=/srv/sage-2x/home          # logs and state

# --- compact expert copies (README.md, "Compact expert copies") -----------------------------------------------------
# Off by default. To turn on, on both boxes: remove the `#` from the EXTRA_ENV line below, write the copies once with
# `docker compose run --rm gr8 prepare`, and restart. The loader then reads dense per-rank copies of its expert ranges
# (72.8 GiB a box). A boot from a cold disk took 18.6 / 18.5 s with both settings, against 29.4 / 29.0 s without.
# EXTRA_ENV holds one line: if you also set GR8_GLM53F_VISION=1, put both in the same line.
# To turn it off again, comment the line out. The copies stay in the volume until you delete the directory.
#EXTRA_ENV="GR8_LOAD_COMPACT=/var/lib/gr8/cache/compact-tp2 GR8_LOAD_MERGE_KB=1"

# --- the image ---------------------------------------------------------------------------------------------------
#IMAGE=

# --- other -----------------------------------------------------------------------------------------------------------
#MODEL=https://huggingface.co/kindlingai/sage-s2.1-flash-exlr8-k4@e55da4682c090821efcac7f5fb85622cb06d1c54
#HF_TOKEN=
