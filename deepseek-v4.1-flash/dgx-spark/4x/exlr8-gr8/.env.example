# DeepSeek-V4.1-Flash on four DGX Sparks (GB10) at TP=4: exlr8 native release, fp8 KV, Engram, fast mode (32 chats).
# Copy to .env next to compose.yaml on all four boxes, the same file on each. PEERS is required unless MENTAT=1: edit
# and uncomment it below. Compose passes each line into the container, where knobs.sh and gr8's launcher read it.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=ds41
# The release fetched into the ds41-release volume by `docker compose run --rm fetch`, pinned to a Hugging Face commit
# (https://huggingface.co/<org>/<repo>@<commit>).
RELEASE=https://huggingface.co/kindlingai/deepseek-v4.1-flash-exlr8-native@98076325aaa2c8dfec6095536d69c47bfcfbb3dc
# Files the fetch and pre-boot check process at once.
#FETCH_JOBS=8
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=
# Where gr8 auto-generates and verifies ds41.engram.cmap on first boot (from <release>/tokenizer.json against
# kCmapSha256) and writes the loader's per-boot Engram index. Lives in the writable home volume.
ENGRAM_PREFIX=/var/lib/gr8/home/engram/ds41

# --- the four boxes --------------------------------------------------------------------------------------------------
TP=4
# EDIT THESE THREE LINES: remove the # and put in your own addresses (README.md, "Clustering"). Until you do, the
# recipe refuses to start. With MENTAT=1, leave all three commented out.
# Their 10G LAN addresses, head first. The head serves the OpenAI API on port 8100.
#PEERS=<head>,<box2>,<box3>,<box4>
# Each box's ConnectX address on PCIe root 1 (IPS) and PCIe root 2 (IPS2), in PEERS order.
#IPS=<head root-1>,<box2 root-1>,<box3 root-1>,<box4 root-1>
#IPS2=<head root-2>,<box2 root-2>,<box3 root-2>,<box4 root-2>
# Four boxes cabled in a ring without a switch (gr8/docs/DEPLOY.md): list PEERS in cable order, each box's f0 port
# cabled to the next box's f1 port, and leave out IPS and IPS2.
#SHAPE=ring
# 0: the boxes in PEERS. 1: find the other boxes and register the API through the host's mentat daemon, in group GROUP.
MENTAT=0
GROUP=gr8-ds41-4x

# --- tuned presets & context -----------------------------------------------------------------------------------------
# What to prioritize (README.md, "Pick what to prioritize"). speed: fast mode, faster and not exact (the default).
# context: fast mode, one chat up to 1,048,566 tokens, 16 chats. quality: the exact model (EXACT=1), 5 chats.
# EXACT=1, the older name, is now TUNE=quality.
TUNE=speed
# The longest chat in tokens, prompt and reply together. Every chat slot gets this much KV at boot.
# Unset: 327680 with TUNE=speed, 1048576 with TUNE=context, 262144 with TUNE=quality (knobs.sh).
#CAP=327680
# Chats at once. Unset: 32 with TUNE=speed, 16 with TUNE=context, 5 with TUNE=quality. Above 5, knobs.sh adds
# GR8_DS_SESS_DRAFTS=1: each chat drafts fewer tokens as more chats write, and none when more than 24 write.
#SESS=32

# --- faster restarts (README.md, "Switch between this and GLM-5.3 on the same four boxes") ---------------------------
# The loader's gen cache, on: the tensors it computes at load, kept on this box's disk and read back on the next boot
# with the same cache key (~80 GB per key in the home volume, keeps two newest keys = up to ~160 GB).
# To turn it off, comment out EXTRA_ENV below and restart on every box.
EXTRA_ENV=GR8_GEN_CACHE=/var/lib/gr8/home/gen-cache

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# Host directory on local NVMe in place of the ds41-release volume (510.6 GB), owned by uid 1000.
#RELEASE_DIR=/srv/ds41/release
# Host directory in place of the ds41-home volume (logs, state, Engram cmap/index, ~80 GB gen cache), owned by uid 1000.
#GR8_HOME_DIR=/srv/ds41/home
# Shutdown grace period for docker stop (raise to 150s with a persistent KV_STORE). Unset, compose's 30s.
#GR8_STOP_GRACE=30s
# Seccomp profile for Engram io_uring. Defaults to the shipped ./seccomp-iouring.json; set to builtin for Docker's
# default profile (Engram falls back to pread automatically).
#SECCOMP_PROFILE=./seccomp-iouring.json
# Override the gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
# Any other gr8 launcher option (gr8/KNOBS.md) works here too, as NAME=VALUE.
