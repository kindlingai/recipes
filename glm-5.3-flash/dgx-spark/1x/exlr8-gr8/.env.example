# GLM-5.3-Flash on one DGX Spark (GB10): bit201 exlr8 manifest, int4 KV, 700K KV pool, DFlash2, disk prompt cache.
# Copy to .env next to compose.yaml. Compose passes each line into the container, where knobs.sh and gr8's launcher
# read it (`docker compose exec gr8 /opt/glm53f-1x/bin/gr8 knobs` lists every gr8 option and its default).
#
# Ready to boot as-is. The active lines are the exact settings for this recipe's default TUNE=speed configuration.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53f
# The release and the drafter, each pinned to a Hugging Face commit (https://huggingface.co/<org>/<repo>@<commit>).
# The model cache is keyed by commit, so a new commit on either repo changes nothing until these move.
MODEL=https://huggingface.co/kindlingai/glm-5.3-flash-exlr8-k2-k3-k4@901ad084f0afd2400820504910d3e684133ce183
# 1: a request alone on the box drafts with the DFlash2 drafter, fetched from Hugging Face and converted on the first
# boot (its licence is CC BY-NC-ND 4.0). 0: MTP only, and the drafter is never fetched.
DFLASH=1
DRAFTER=https://huggingface.co/incoai/GLM-5.3-Flash-DFlash2@bf582e4eacc1810f76656d1811693ff6c6737d2a
# The release's manifest: bit201 (the default), or k2 for every routed expert at K2 (about 0.4 GB smaller).
VARIANT=bit201
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- topology --------------------------------------------------------------------------------------------------------
TP=1
# 0: this box alone (knobs.sh sets PEERS=127.0.0.1). 1: register with the mentat cluster through the host's mentat
# daemon, in group GROUP.
MENTAT=0
GROUP=gr8-glm53f-1x

# --- tuned presets & context -----------------------------------------------------------------------------------------
# What to prioritize (README.md, "Pick what to prioritize"). speed: requests up to 262,144 tokens (the default).
# context: one request up to 700,018 tokens. quality: the same as speed.
TUNE=speed
# The KV pool in tokens, shared by the sessions (about 5 KB of memory a token), a multiple of 64.
CAP=700032
# Four requests decode at once; a request alone drafts with DFlash2.
SESS=4
KV_FORMAT=int4
# The longest single request, prompt and output together, at most CAP less the guard rows (and 1,048,576).
# Unset: set by knobs.sh from TUNE (262144 for speed/quality, 700018 for context). With a smaller CAP and TUNE=context,
# set it too.
#MAX_MODEL_LEN=262144

# --- prompt cache & memory headroom ----------------------------------------------------------------------------------
# Aligned checkpoint prompt cache on disk (/var/lib/gr8/cache/prompts, up to 64 GB, see kv-store.yaml).
FLASH_CACHE=aligned
KV_STORE=@/etc/gr8/kv-store.yaml
# One prefill lane (the second lane's scratch does not fit beside the weights at TP=1).
EXTRA_ARGS=--pf-lanes 1
# Keep 5 GiB free at boot (gr8's default 8 GiB leaves no room for CAP=700032 beside the weights).
EXTRA_ENV=GR8_MEM_MIN=5

# --- repetition, tool calls & thinking budget ------------------------------------------------------------------------
# Presence penalty on thinking tokens (0.5) to stop reasoning loops on long agent turns, plus 0.2 on greedy replies.
# Sampled replies are not penalized. A client's own presence_penalty is added on top. 0 turns it off.
DEFAULT_PRESENCE_PENALTY=greedy=0.2,greedy.thinking=0.5,nongreedy.thinking=0.5
# Undeclared tool calls come back in tool_calls so agents can reply with an unknown-tool error; text leaves them in content.
UNDECLARED_TOOL_CALLS=emit
# A request that names no max_tokens gets 32,768 tokens. From 16,384 thinking tokens, </think> logit gains 4 per 1K up
# to 10; thinking closes at 28,672 tokens at the latest, leaving 4,096 to answer. Request values win.
DEFAULT_MAX_TOKENS=32768
DEFAULT_THINK_END_BOOST=start=16384,per1k=4,max=10
DEFAULT_THINKING_BUDGET=28672

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A host directory for the model (~87 GB), converted drafter, and prompt cache (up to 64 GB), owned by uid 1000.
# Unset, a named docker volume.
#GR8_CACHE=/srv/glm53f/cache
# A host directory for logs and state, owned by uid 1000. Unset, a named docker volume.
#GR8_HOME=/srv/glm53f/home
# Shutdown grace period for docker stop. Unset, compose's 30s.
#GR8_STOP_GRACE=30s
# Override the gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
# Any other gr8 launcher option (gr8/KNOBS.md) works here too, as NAME=VALUE.
