# GLM-5.3 Full (743B) on two DGX Sparks at TP=2 (EXLR8 bit225, 4-bit MLA latent KV, native INT4 DFlash, 48 GB NVMe SSD KV).
# Copy to .env next to compose.yaml on both boxes (same file on both boxes). Set PEERS to your two LAN addresses.
# The active lines are the exact settings the README's Results numbers were measured with.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
# Pinned Hugging Face commit (bit225 width profile) the measured numbers come from.
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@501d259894bf0de607ee4aa6f8a564a14d0c6b63
# Public DFlash drafter (converted locally to tp2-int4 per rank on first boot; CC BY-NC-ND). Remove to draft with MTP only.
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2@425aa615ce320caac34400208b30808c8f14f76c
# Width manifest (bit225 = 2.25 bpw mixed-precision EXLR8 profile to fit 743B on 2x 128 GB Sparks).
VARIANT=bit225
# Optional Hugging Face token for gated or private repos.
#HF_TOKEN=

# --- 4-bit MLA latent KV + 48 GB NVMe SSD KV store + native INT4 DFlash ----------------------------------------------
# 4-bit MLA latent KV (416 B/layer/tok excl. indexer vs 656 B FP8) + FP8 kv_b projections (KVB=fp8).
# Built-in 48 GB NVMe SSD KV store lets 4 concurrent lanes hold ~307K active context with 99.2% prefix cache hit.
# Note: 2-Spark TP=2 runs tight on unified RAM (0.686 GiB live free RAM floor at CAP=172032 with GR8_MEM_MIN=1). Keep
# 50+ GB free on NVMe and do not run other GPU or heavy memory workloads alongside it.
KV_FORMAT=int4
KVB=fp8
KV_STORE=ssd:/var/lib/gr8/home/kv-store,size=48G,persist=off,keep=all
# Multi-lane agentic default (RealMark 935.5 Grade A, 16/16 all lanes, 128K needle PASS): CAP=172032, SESS=4.
CAP=172032
MAX_MODEL_LEN=172032
SHARE_LIMIT=4096
SESS=4
# Native INT4 DFlash + MTP=1 with adaptive speculation.
MTP=1
DFLASH=1
SPEC_ADAPT=1
JOIN_TIMEOUT=1800
READY_TMO=1800

# --- topology --------------------------------------------------------------------------------------------------------
# Two LAN addresses in rank order (same line on both boxes). The first address is the head (OpenAI API on port 8100).
# Replace the RFC 5737 documentation placeholders below with your boxes' real addresses.
TP=2
PEERS=192.0.2.1,192.0.2.2
# Fabric shape: mesh (200G RoCE v2 switch) or direct (back-to-back cable between two Sparks).
SHAPE=mesh
# Optional explicit RoCE v2 rail IPs when your ConnectX rails differ from PEERS.
#IPS=10.96.0.1,10.96.0.2
#IPS2=10.98.0.1,10.98.0.2

# --- engine knobs (passed through to the engine) ---------------------------------------------------------------------
EXTRA_ENV="GR8_QUIT_FAST=1 GR8_KV_SHARE_PAGES=1 GR8_REUSE_GRID=64 GR8_SPEC_K0=1 GR8_MEM_MIN=1"

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# Host directory for this box's part of the model (~115 GB at TP=2 for bit225 + dense/drafter), owned by uid 1000.
# Unset, a named docker volume.
#GR8_CACHE=/srv/gr8/cache
# Host directory for logs, state, and the 48 GB NVMe SSD KV store (needs >= 55 GB free), owned by uid 1000.
# Unset, a named docker volume.
#GR8_HOME=/srv/gr8/home
# Shutdown grace period. Unset, compose's 30s.
#GR8_STOP_GRACE=30s
# Override the gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
