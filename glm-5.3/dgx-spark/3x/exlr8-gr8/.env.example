# GLM-5.3 on three DGX Sparks at TP=3 (384K context, bit273). Copy to .env next to compose.yaml on every box: the
# same file on all three. Compose passes each line into the container, where gr8's launcher reads it as an option
# (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option and its default).
#
# Set PEERS. The other active lines are the settings the README's numbers were measured with.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
# The release, pinned to the Hugging Face commit (v0.6) the README's numbers were measured with.
# The model cache is keyed by commit, so a new commit on the repo changes nothing here until this line moves.
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@3e388b45b26ca4558351d22994afcfc85b99af74
# High-precision TP=3 width profile: 2.73 bpw (~84 GB experts/box, 8 busiest experts/layer in K4 + 10 more layers in K3).
# For 512K context (CAP=524288) with 5.3+ GiB free RAM per box, switch to VARIANT=bit260 and CAP=524288.
VARIANT=bit273
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of each of the three boxes, in rank order, the same line on every box. The first is the head
# (OpenAI API on port 8100).
PEERS=192.0.2.1,192.0.2.2,192.0.2.3
TP=3
# Boxes on a 200G switch use SHAPE=mesh. No switch (direct-cabled triangle): switch to SHAPE=ring.
SHAPE=mesh
# Per box: this box's LAN address, when PEERS holds more than one address of this box.
#NODE_IP=

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A host directory for this box's part of the model (~97 GB at TP=3 for bit273), owned by uid 1000.
# Unset, a named volume.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000.
#GR8_HOME=/srv/gr8/home

# --- 384K context & tuned TP=3 settings (the settings of the measured serve, gr8 v1.1.1) -----------------------------
READY_TMO=1800
# int4 KV: CAP 393,216 (2,389 physical pages/rank, max_model_len 393,210) with 8 concurrent sessions.
# Leaves 4.38+ GiB free RAM per box after boot (3.80+ GiB after bench, 3.64+ GiB after 359K & 4x87K live stress).
KV_FORMAT=int4
KVB=bf16
CAP=393216
SHARE_LIMIT=32768
SESS=8
REUSE=1
REUSE_GRID=64
# MTP=3 drafting with solo and shared-batch confidence stopping (DFlash2's 8 KV heads do not split 3 ways).
MTP=3
DFLASH=0
SPEC_ADAPT=0
SPEC_ACCEPT=rejection
MTP_LASTROW=1
DRAFT_HEAD_I4=1
DRAFT_HEAD2=1
MTP_KSTOP=1
MTP_KSTOP_KMAX=3
MTP_KSTOP_TAU=0,0.5,0.75
MTP_KSTOPB=1
MTP_KSTOPB_TAU_S=2:0.7,0.8,0.9/3:0.7,0.88,0.95/4:0.7,0.75,0.9
MTP_KSTOPB_WIDTHS=2,3,5,6,7,9,10,11,13,14,15
L2PF=31
MTP_L2PF=3
# Distributed prefill with owned-row attention (no QO cache required; ~82 s boot from disk).
# PF_ATTN_ROWS=1536 is required with PF_OWN=2 on gr8 v1.1.1.
PF_OWN=2
PF_ATTN_ROWS=1536
PF_GEMMF32=1
PF_SELX_CTX=53248
DEC_BK=2048
DEC_BK_MAX=2048
TR3_W2ALL=1
ROUTE_OVL=1
ATTN_SC2=4
ATTN_SC2_TR=2
ATTN_CTX2=4
ATTN_CTX3=2
ATTN_SEL2=16
IDX_GRP=16
ATTN_QT=1
ATTN_FRONT=1
IDX_VEC=1
S2_ADAPT=1
S2_DECODE_PF=4096
S2_ADMIT_HOLD=1
KV4_SC=4
KV4_SC_TR=2
KV4_QT=1
KV4_CTX=2
KV4_FUSE_ROT=1
KV4_FOLD=1
KV4_TC=1
# Seven bit-exact v1.1.1 decode & prefill kernels (KL = 0.00000).
DEC_DENSE_OPT=1
DTR_EXACT_OPT=1
MOE_RTR_FIN_OPT=1
TR3_WIDE4=1
PF_ATTN_OPT=1
PF_DENSE_OPT=1
PF_ISGRT_CLEAN=1
# Speed / quality preset (MoE expert union cap across concurrent tokens in a decode step):
#   48 (default): Quality preset (51.6 tok/s code, 77.5 tok/s at 4 streams, 106.5 tok/s at 8 streams; GSM8K 245/250, HumanEval 150/164).
#   32:           Fast preset (51.2 tok/s code, 85.7 tok/s at 4 streams, 119.1 tok/s at 8 streams).
#   0:            Uncapped exact (strict KL=0.00000: 51.0 tok/s code, 68.7 at 4 streams, 81.9 at 8 streams).
MOE_UNION_CAP=48
# GR8_KV_SHARE_PAGES=1: zero-copy shared prefix pages across concurrent sessions (4x87K live-proven).
# GR8_QUIT_FAST=1: an orderly stop ends right after the quit barrier.
EXTRA_ENV="GR8_KV_SHARE_PAGES=1 GR8_QUIT_FAST=1 GR8_K1_SPLIT=1:/4,2-3:2x1,4-32:8x1/4 GR8_K1_TLBW=2048"

# --- optional: persistent SSD KV store -------------------------------------------------------------------------------
# Uncomment to save active chats to disk on orderly stop and reload them on next boot (requires GR8_STOP_GRACE=150s).
#KV_STORE=ssd:/var/lib/gr8/cache/kv,size=200G,persist=on,keep=sessions
#GR8_STOP_GRACE=150s
