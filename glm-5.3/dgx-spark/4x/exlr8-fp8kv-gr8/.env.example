# GLM-5.3 on four DGX Sparks at TP=4 (pure FP8 KV, 640K pool, uncapped exact MoE routing).
# Copy to .env next to compose.yaml on all four boxes (same file on every box). Set PEERS to your four LAN addresses.
# The active lines are the exact settings the README's Results numbers were measured with.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
# Pinned Hugging Face commit (v0.6, bit325 width profile) the measured numbers come from.
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@3e388b45b26ca4558351d22994afcfc85b99af74
# Public DFlash drafter (converted locally per rank on first boot; CC BY-NC-ND). Remove to draft with MTP only.
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2@425aa615ce320caac34400208b30808c8f14f76c
# Width manifest (bit325 = 3.25 bpw default for maximum FP8 KV headroom).
VARIANT=bit325
# Optional Hugging Face token for gated or private repos.
#HF_TOKEN=

# --- pure FP8 KV & uncapped exact quality settings (measured on gr8 v1.2.0) -----------------------------------------
# Pure FP8 KV (bin/g6m4, 656 B/row latent — no INT4 KV) with BF16 kv_b projections (KVB=bf16).
# CAP 655,360 (2,944 physical pages/rank, max_model_len 655,346) with SHARE_LIMIT=32,768 and 8 concurrent sessions.
# Preserves 6.4+ GiB live free OS memory per box under RealMark C=4 and multi-session stress.
KV_FORMAT=fp8
KVB=bf16
CAP=655360
MAX_MODEL_LEN=655360
SHARE_LIMIT=32768
SESS=8
# DFlash + MTP=2 speculative drafting (all v1.2.0 bit-exact kernels remain ON by default).
MTP=2
DFLASH=1
# Uncapped exact MoE routing (KL = 0.00000). Optional speed presets: 48 (balanced) or 32 (max multi-stream throughput).
MOE_UNION_CAP=0

# --- topology --------------------------------------------------------------------------------------------------------
# Four LAN addresses in rank order (same line on every box). The first address is the head (OpenAI API on port 8100).
# Replace the RFC 5737 documentation placeholders below with your boxes' real addresses.
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4
# Optional explicit dual-rail 200G RoCE addresses when boxes have two ConnectX-7 switch links:
#IPS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4
#IPS2=198.51.100.1,198.51.100.2,198.51.100.3,198.51.100.4
# Switchless ring cabling (TP=4 only; ~10% slower single-stream decode than switch mesh):
#SHAPE=ring
# Per box: set NODE_IP if PEERS contains more than one address belonging to this box.
#NODE_IP=

# --- shared prefix pages & fast restarts -----------------------------------------------------------------------------
# GR8_KV_SHARE_PAGES=1: zero-copy physical page sharing for common system/repo prefixes across concurrent chats.
# GR8_GEN_CACHE: caches load-time generated tensors across boots (~66 s warm restart).
# GR8_QUIT_FAST=1: orderly stop exits immediately after the quit barrier.
EXTRA_ENV="GR8_KV_SHARE_PAGES=1 GR8_GEN_CACHE=/var/lib/gr8/cache/gen-cache GR8_QUIT_FAST=1"

# --- optional persistent SSD KV store --------------------------------------------------------------------------------
# Uncomment if every box has >= 200 GB free disk and you want sessions persisted across restarts:
#KV_STORE=ssd:/var/lib/gr8/cache/kv,size=200G,persist=on,keep=sessions

# --- the container (read by compose, not the launcher) ---------------------------------------------------------------
# Optional host directories owned by uid 1000. Unset uses Docker named volumes.
#GR8_CACHE=/srv/gr8/cache
#GR8_HOME=/srv/gr8/home
# Longer shutdown grace when persisting sessions to SSD KV store. Unset, compose's 30s.
#GR8_STOP_GRACE=150s
# Override the gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
