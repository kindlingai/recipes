# GLM-5.3 K4 (bit387, pure quality) on four DGX Sparks at TP=4 (442K KV pool, uncapped MoE routing).
# Copy to .env next to compose.yaml on all four boxes, the same file on each. Compose passes each line into the
# container, where gr8's launcher reads it as an option (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every
# option and its default).
#
# Ready to boot as-is with mentat (or uncomment PEERS below). The active lines are the exact settings the README's
# Results numbers were measured with.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
# The exlr8 release, pinned to the Hugging Face commit (v0.7) the README's numbers were measured with. The model cache
# is keyed by commit, so a new commit on the repo changes nothing here until this line moves.
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@9e25c28a2e8808d8b2599d780521fd6af24e7558
# DFlash2 drafter (CC BY-NC-ND): each box converts its own copy on first boot. Remove to draft with MTP only.
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2@425aa615ce320caac34400208b30808c8f14f76c
# The bit387 width manifest, bind-mounted read-only from ./manifests into /etc/gr8/ by compose.yaml. bit387 puts every
# routed expert at K4 except layers 3-12 (and MTP layer 78) at K3 — statistically identical KL to all-K4 bit400 in
# 12 GB less. Although manifests/exlr8-manifest-bit387.json is in the HF release at 9e25c28a, gr8 v1.1.1's built-in
# variant list does not include bit387 by name, so this recipe boots it by mounted path.
VARIANT=/etc/gr8/exlr8-manifest-bit387.json
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- topology --------------------------------------------------------------------------------------------------------
TP=4
# Without PEERS, each box finds the others through its local mentat daemon (gr8's default). Without mentat, uncomment
# PEERS (and IPS / IPS2 if needed) and fill them in, the same lines on every box. The head (first in PEERS) serves
# the OpenAI API on port 8100.
#PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4
# Each box's ConnectX address on PCIe root 1 (IPS) and PCIe root 2 (IPS2), in PEERS order. Unset, each box finds its own.
#IPS=10.0.1.1,10.0.1.2,10.0.1.3,10.0.1.4
#IPS2=10.0.2.1,10.0.2.2,10.0.2.3,10.0.2.4
# No switch: the boxes are cabled in a ring, in PEERS order.
#SHAPE=ring
# Per box: this box's LAN address, when PEERS holds more than one address of this box.
#NODE_IP=

# --- tuned settings (measured pure-quality K4 serve) -----------------------------------------------------------------
# Mixed-precision int4 MLA latent KV (BF16 RoPE keys, FP8 indexer keys): lets ~89 GB/box of K4 experts coexist with a
# 442K-token KV pool and 4.3+ GiB free RAM per box. Set KV_FORMAT=fp8 for FP8 KV with a smaller pool.
KV_FORMAT=int4
# Lends each box's 2 GiB display carveout to attention KV when Kindling OS runs dispramd (0 turns it off).
DISPRAM=1
# KV pool: 442,368 tokens (1,920 pages of 64 tokens per box, max_model_len 442,354). Each box replicates a session's
# first SHARE_LIMIT tokens and shards the rest 1/4, so four ~74K sessions share the pool without evicting prefixes.
CAP=442368
SHARE_LIMIT=16384
# Fixes the MTP draft count to drop extra decode CUDA graphs and preserve RAM headroom for K4 experts.
S2_ADAPT=0
# Three decode graph buckets (2K, 16K, cap) instead of 16K/32K/cap: bit-exact, leaves 4.3+ GiB free per box after boot.
DEC_BK=2048
DEC_BK_MAX=2048
# Pure quality (uncapped MoE routing, KL=0.00000): gr8 v1.1.x defaults MOE_UNION_CAP=48 at TP=4; this K4 recipe MUST
# keep MOE_UNION_CAP=0 so routed experts stay 100% uncapped (checked by check.sh).
MOE_UNION_CAP=0

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A host directory for this box's part of the model (~100 GB at TP=4), owned by uid 1000. Unset, a named docker volume.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000. Unset, a named docker volume.
#GR8_HOME=/srv/gr8/home
# Longer shutdown grace when a persistent SSD KV_STORE is enabled. Unset, compose's 30s.
#GR8_STOP_GRACE=150s
# Override the gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
