# GLM-5.3 on six DGX Sparks at TP=6 (pure FP8 KV, 1.51M pool, 1M max context, uncapped exact MoE routing).
# Copy to .env next to compose.yaml on all six boxes (same file on every box). Set PEERS to your six LAN addresses.
# The active lines are the exact settings the README's Results numbers were measured with.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53
# Pinned Hugging Face commit (v0.6, bit325 width profile) the measured numbers come from.
MODEL=https://huggingface.co/kindlingai/glm-5.3-exlr8-k2-k3-k4@3e388b45b26ca4558351d22994afcfc85b99af74
# Public DFlash drafter (replicated body on TP=6; converted locally on first boot; CC BY-NC-ND).
DRAFTER=https://huggingface.co/incoai/GLM-5.3-DFlash2@425aa615ce320caac34400208b30808c8f14f76c
# Width manifest:
#   bit325 (default): 3.25 bpw experts (~49.9 GB/rank) -> 1,507,328 FP8 KV pool (1M max context, 4x250K multi-session).
#   bit390 (K4 quality option): 3.90 bpw experts (~60.0 GB/rank) -> set VARIANT=bit390, CAP=524288, MAX_MODEL_LEN=524288.
VARIANT=bit325
# Optional Hugging Face token for gated or private repos.
#HF_TOKEN=

# --- topology --------------------------------------------------------------------------------------------------------
# Six LAN addresses in rank order (same line on every box). The first address is the head (OpenAI API on port 8100).
# Six boxes require a 200G RoCE v2 switch (SHAPE=mesh; rings support TP=3 or TP=4 only).
# Replace the RFC 5737 documentation placeholders below with your boxes' real addresses.
PEERS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4,192.0.2.5,192.0.2.6
TP=6
SHAPE=mesh
# Optional explicit dual-rail 200G RoCE addresses when boxes have two ConnectX-7 switch links:
#IPS=192.0.2.1,192.0.2.2,192.0.2.3,192.0.2.4,192.0.2.5,192.0.2.6
#IPS2=198.51.100.1,198.51.100.2,198.51.100.3,198.51.100.4,198.51.100.5,198.51.100.6
# Per box: set NODE_IP if PEERS contains more than one address belonging to this box.
#NODE_IP=

# --- pure FP8 KV & uncapped exact quality settings (measured on gr8 v1.2.0) -----------------------------------------
# Pure FP8 KV (bin/g6m4, 656 B/row latent — no INT4 KV) with BF16 kv_b projections (KVB=bf16).
# CAP 1,507,328 (4,352 physical pages/rank, max_model_len 1,048,576) with SHARE_LIMIT=32,768 and 8 concurrent sessions.
# Preserves 6.4+ GiB live free OS memory per box under RealMark C=4 and 972K multi-session stress.
KV_FORMAT=fp8
KVB=bf16
CAP=1507328
MAX_MODEL_LEN=1048576
SHARE_LIMIT=32768
SESS=8
REUSE=1
REUSE_GRID=64

# DFlash + MTP=2 speculative drafting + v1.2.0 bit-exact prefill/decode kernels.
MTP=2
DFLASH=1
DFL_DEDUP=1
DFL_REUSE_MIN=0
MTP_LASTROW=1
DRAFT_HEAD_I4=1
DRAFT_HEAD2=1
L2PF=31
MTP_L2PF=3
PF_OWN=3
QO_CACHE=/var/lib/gr8/cache/qocache
READY_TMO=1800
PF_GEMMF32=1
PF_SELX_CTX=53248
DEC_BK=2048
DEC_BK_MAX=2048
TR3_W2ALL=1
ROUTE_OVL=1
ATTN_SC2=4
ATTN_SC2_TR=2
ATTN_CTX2=4
ATTN_CTX3=2
ATTN_SEL2=16
IDX_GRP=16
ATTN_QT=1
ATTN_FRONT=1
IDX_VEC=1
S2_ADAPT=1
S2_DECODE_PF=4096
S2_ADMIT_HOLD=1
# Uncapped exact MoE routing (KL = 0.00000). Optional speed presets: 48 (balanced) or 32 (max multi-stream throughput).
MOE_UNION_CAP=0

# --- shared prefix pages & fast restarts -----------------------------------------------------------------------------
EXTRA_ENV="GR8_KV_SHARE_PAGES=1 GR8_GEN_CACHE=/var/lib/gr8/cache/gen-cache GR8_QUIT_FAST=1"

# --- optional persistent SSD KV store --------------------------------------------------------------------------------
# Uncomment if every box has >= 200 GB free disk and you want sessions persisted across restarts:
#KV_STORE=ssd:/var/lib/gr8/cache/kv,size=200G,persist=on,keep=sessions

# --- the container (read by compose, not the launcher) ---------------------------------------------------------------
# Host directory for this box's model slice (~50 GB at bit325) and QO cache (~13 GB), owned by uid 1000.
# Create $GR8_CACHE/qocache before first boot (see README.md Quickstart) so PF_OWN=3 writes and reuses the QO cache.
GR8_CACHE=/srv/gr8/cache
# Optional host directory for logs and state, owned by uid 1000. Unset uses a Docker named volume.
#GR8_HOME=/srv/gr8/home
# Longer shutdown grace when persisting sessions to SSD KV store. Unset, compose's 30s.
#GR8_STOP_GRACE=150s
# Override the gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
