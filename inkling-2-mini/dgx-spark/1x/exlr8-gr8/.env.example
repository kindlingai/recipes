# Inkling-2-Mini EXLR8 + DFlash on 1x DGX Spark (NVIDIA GB10, 128 GB)
# Copy to .env next to compose.yaml:  cp .env.example .env

# Host directory containing kindlingai/inkling-2-mini-exlr8-k2-k3-k4
# (includes the bundled 279 MB DFlash drafter, auto-discovered with zero extra flags)
MODEL_DIR=./models/inkling-2-mini-exlr8-k2-k3-k4

# Width manifest preset:
#   bit325 — Default (16.43 GB): performed nearly the same as 4-bit in evals except graduate-level science (GPQA); 8/8 exact DFlash greedy parity
#   k4     — Higher quality (18.72 GB): recommended for maximum quality & graduate-level science (-27.4% KL vs Official NVFP4, ties W4A4 on 1,362 tasks)
#   bit225 — Fast version (13.37 GB): 2.25-bit speed tier (0.041282 KL, -21.3% lower KL than k2; up to 133.5 Code / 160.2 Math / 228.2 C=6 tok/s)
#   bit250 — Compact mid-tier (14.13 GB, 0.030018 KL)
#   k2     — Minimum footprint (12.60 GB, -11.65% E2E KL vs stock k2, up to 230.0 C=6 / 479.5 6x Math)
VARIANT=bit325

# DFlash speculative decoding (auto-discovered in MODEL_DIR)
MTP=7

# Maximized context & concurrency on 128 GB Spark (g6m4_ink2 max SESSIONS=8):
#   Default (144K x 8, moe=2):  CAP=147456, SESSIONS=8  (1.18M KV pool, ~9.6 GiB free, full 3,484 tok/s 8K prefill)
#   Max moe=2 (160K x 8):       CAP=163840, SESSIONS=8  (1.31M KV pool, ~5.5 GiB free)
#   256K x 5 (moe=2):           CAP=262144, SESSIONS=5  (1.31M KV pool, ~5.5 GiB free)
#   192K x 8 (PF_MX8_MOE=1):    CAP=196608, SESSIONS=8  (1.57M KV pool, ~9.1 GiB free)
#   256K x 8 (PF_MX8_MOE=0):    CAP=262144, SESSIONS=8  (2.10M KV pool, ~4.4 GiB free)
#   Full 1M native (1M x 1):    CAP=1048576, SESSIONS=1 (1,048,576/session, ~7.8+ GiB free)
#   Note: If switching to VARIANT=k4 with PF_MX8_MOE=2, use CAP=131072 SESSIONS=8 or CAP=262144 SESSIONS=4 (1M KV pool, ~12 GiB free).
CAP=147456
SESSIONS=8
CHUNK=8
PREFILL=4096
HOST=0.0.0.0
PORT=8100

# Default reasoning effort exposed by the OpenAI frontend: none | low | medium | high
REASONING_EFFORT=none

# Unified high-quality defaults (0.000000 decode KL delta vs pure trellis):
#   PF_MX8_MOE=2  — cached MXFP8 prefill MoE (3,457-3,484 tok/s 8K cold prefill)
#   MX8_DENSE=2   — MXFP8 dense projections for prefill (M>=64), BF16 for decode
#   MX8_LM_HEAD=0 — BF16 lm_head
GR8_INK2_DF2_Q8=0
GR8_INK2_PF_MX8_MOE=2
GR8_INK2_MX8_DENSE=2
GR8_INK2_MX8_LM_HEAD=0

# Optional: uncomment for the bit225 fast profile (up to 133.5 Code / 160.2 Math / 228.2 C=6 tok/s)
# VARIANT=bit225
# GR8_INK2_MX8_DENSE=1
# GR8_INK2_MX8_LM_HEAD=1
# GR8_S2_ADAPT=1
# GR8_INK2_S2_COST=14.0,2.5,2.0,0.4,0.0,0.0
