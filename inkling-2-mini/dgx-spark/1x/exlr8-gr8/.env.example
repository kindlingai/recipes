# Inkling-2-Mini EXLR8 + DFlash on 1x DGX Spark (NVIDIA GB10, 128 GB)
# Copy to .env next to compose.yaml:  cp .env.example .env

# Host directory containing kindlingai/inkling-2-mini-exlr8-k2-k3-k4
# (includes the bundled 279 MB DFlash drafter, auto-discovered with zero extra flags)
MODEL_DIR=./models/inkling-2-mini-exlr8-k2-k3-k4

# Width manifest preset:
#   k4     — Default quality preset (18.72 GB, -27.4% KL vs Official NVFP4, 93.54% on 1,362 tasks)
#   bit325 — Balanced daily driver (16.43 GB, 8/8 exact DFlash greedy parity, 3,484 tok/s 8K prefill)
#   bit250 — Compact high-speed coding/math (14.13 GB, 111 tok/s Code, 133 tok/s Math)
#   k2     — Maximum throughput (12.60 GB, -11.65% E2E KL vs stock k2, up to 230 C=6 / 480 6x Math)
VARIANT=k4

# DFlash speculative decoding (auto-discovered in MODEL_DIR)
MTP=7

# Context & serving geometry (maximized 1M total KV pool for 128 GB Spark, ~12 GiB OS headroom):
#   Default (256K x 4):   CAP=262144, SESSIONS=4  (256K/session, 1,048,576 total KV pool)
#   Multi-user (128K x8): CAP=131072, SESSIONS=8  (128K/session, 1,048,576 total KV pool)
#   Full 1M single-stream: CAP=1048576, SESSIONS=1 (1,048,576/session, 1M native context)
CAP=262144
SESSIONS=4
CHUNK=8
PREFILL=4096
HOST=0.0.0.0
PORT=8100

# Default reasoning effort exposed by the OpenAI frontend: none | low | medium | high
REASONING_EFFORT=none

# Unified high-quality defaults (0.000000 decode KL delta vs pure trellis):
#   PF_MX8_MOE=2  — cached MXFP8 prefill MoE (3,457-3,484 tok/s 8K cold prefill)
#   MX8_DENSE=2   — MXFP8 dense projections for prefill (M>=64), BF16 for decode
#   MX8_LM_HEAD=0 — BF16 lm_head
GR8_INK2_DF2_Q8=0
GR8_INK2_PF_MX8_MOE=2
GR8_INK2_MX8_DENSE=2
GR8_INK2_MX8_LM_HEAD=0

# Optional: uncomment for the K2 maximum-speed profile
# VARIANT=k2
# GR8_INK2_MX8_DENSE=1
# GR8_INK2_MX8_LM_HEAD=1
# GR8_S2_ADAPT=1
# GR8_INK2_S2_COST=14.0,2.5,2.0,0.4,0.0,0.0
