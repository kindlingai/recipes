# Inkling-2-Mini EXLR8 + DFlash on 1x NVIDIA RTX 5090 (32 GB, sm_120a)
# Copy to .env next to compose.yaml:  cp .env.example .env

# Host directory containing kindlingai/inkling-2-mini-exlr8-k2-k3-k4
# (includes the bundled 279 MB DFlash drafter, auto-discovered with zero extra flags)
MODEL_DIR=./models/inkling-2-mini-exlr8-k2-k3-k4

# Optional named profile shortcut (overrides VARIANT / fast flags / long-context sizing):
#   bit325 | k4 | bit225 | bit225-fast | bit250 | k2 | k2-fast | long
# PROFILE=

# Width manifest preset (all fit inside 32 GB VRAM with DFlash + large KV cache):
#   bit325 — Default (16.43 GB): performed nearly the same as 4-bit in evals except graduate-level science (GPQA); 8/8 exact DFlash greedy parity
#   k4     — Higher quality (18.72 GB): recommended for maximum quality & graduate-level science (-27.4% KL vs Official NVFP4, ties W4A4)
#   bit225 — Fast version (13.37 GB): 2.25-bit speed tier (0.041282 KL, -21.3% lower KL than k2; up to 354 Code / 768 C=4 / 528 C=6 thinking)
#   bit250 — Compact mid-tier (14.13 GB, 0.030018 KL)
#   k2     — Minimum footprint (12.60 GB, -11.65% E2E KL vs stock k2)
VARIANT=bit325

# DFlash speculative decoding (auto-discovered in MODEL_DIR)
MTP=7

# Maximized dedicated 32 GB RTX 5090 context & concurrency (~2 GiB free VRAM headroom):
# Leave CAP blank to auto-select the variant's maximized 4-stream default (or set explicitly):
#   bit325 (default): CAP=65536, SESSIONS=4  (262K KV pool, 29.71 GiB) | PROFILE=long -> 303K x 1
#   k4:               CAP=49152, SESSIONS=4  (196K KV pool, 29.74 GiB) | PROFILE=long -> 245K x 1
#   bit225:           CAP=90112, SESSIONS=4  (360K KV pool, 30.00 GiB) | PROFILE=long -> 385K x 1
#   bit225-fast:      CAP=81920, SESSIONS=4  (327K KV pool, 29.40 GiB)
#   Shared-GPU host (~7 GiB used by other services): set CAP=16384 SESSIONS=4 PREFILL=256 (or SESSIONS=6 for bit225/k2)
# CAP=65536
SESSIONS=4
CHUNK=8
PREFILL=512
HOST=127.0.0.1
PORT=8100

# Default reasoning effort exposed by the OpenAI frontend: none | low | medium | high
REASONING_EFFORT=none

# Unified RTX 5090 (32 GB) defaults (0.000000 decode KL delta vs pure trellis):
#   PF_MX8_MOE=0  — skips the 23.49 GiB extra MXFP8 MoE cache (for 128 GB boxes) to maximize 32 GB VRAM + KV
#   MX8_DENSE=2   — MXFP8 dense projections for prefill (M>=64), BF16 for decode
#   MX8_LM_HEAD=0 — BF16 lm_head
GR8_INK2_DF2_Q8=0
GR8_INK2_PF_MX8_MOE=0
GR8_INK2_MX8_DENSE=2
GR8_INK2_MX8_LM_HEAD=0

# Optional: uncomment for the bit225 fast profile (or set PROFILE=bit225-fast above)
# VARIANT=bit225
# GR8_INK2_MX8_DENSE=1
# GR8_INK2_MX8_LM_HEAD=1
# GR8_S2_ADAPT=1
# GR8_INK2_S2_COST=14.0,2.5,2.0,0.4,0.0,0.0

# Override the pinned gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
