# Nemotron 3.5 Bolt 74B-A9B (24GB) on 1× RTX 5090 (32 GB): fp8 KV, b12x linear/MoE, DFlash LiLiCorr drafter.
# Copy to .env next to compose.yaml. Ready to boot as-is with the default `fast` profile.

# --- the model -------------------------------------------------------------------------------------------------------
# Hugging Face repo id (fetched into CACHE_DIR on first boot) or a mounted local path.
MODEL=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB
# Pinned Hugging Face commit of MODEL (matches kindling.json weights_commit). Clear when pointing MODEL at a local dir.
MODEL_REVISION=e0590ed2f3a564fd99725d9d891cb09deb7cc201
SERVED_MODEL_NAME=nemotron-3.5-bolt
# OpenAI API host port (recipe standard: 8100).
PORT=8100
# Sent only to Hugging Face, for a gated or private repo or higher download rate limits.
#HF_TOKEN=

# --- profile ---------------------------------------------------------------------------------------------------------
# Preset selecting the measured RTX 5090 32 GB settings (any individual knob below overrides the profile default):
#   fast  : DFlash LiLiCorr drafter (5 tokens), 1 seq, 262K context, GMU 0.95, batched 4096 (best single-user speed)
#   long  : no drafter, 1 seq, 262K context, GMU 0.96, batched 4096 (larger KV pool, ~773K tokens)
#   multi : no drafter, 8 seqs, 32K context, GMU 0.88, batched 2048, CUDA-graph estimate off (8 concurrent streams)
PROFILE=fast

# --- individual knob overrides (leave commented to use PROFILE defaults) ---------------------------------------------
# Maximum context window in tokens (262144 for fast/long, 32768 for multi).
#MAX_MODEL_LEN=262144
# Maximum concurrent sequences (1 for fast/long, 8 for multi).
#MAX_NUM_SEQS=1
# Fraction of 32 GB VRAM reserved by vLLM (0.95 fast, 0.96 long, 0.88 multi).
#GPU_MEMORY_UTILIZATION=0.95
# Prefill chunk size (4096 for fast/long gives +4.5–5% 196K prefill; 8192 OOMs at startup; 2048 for multi).
#MAX_NUM_BATCHED_TOKENS=4096
# DFlash LiLiCorr drafter repo id or local path. Set empty (DRAFTER=) to disable speculative decoding.
#DRAFTER=nvidia/NVIDIA-Nemotron-3.5-Bolt-74B-A9B-24GB-LiLiCorr
# Pinned Hugging Face commit of DRAFTER. Clear when pointing DRAFTER at a local directory.
#DRAFTER_REVISION=449d24140160b8e51871bfc0f0a7338abf640aa1
# Draft tokens per verify step (5 fits full 262K context and beats 7 on decode speed; max 7 for LiLiCorr).
#NUM_SPECULATIVE_TOKENS=5
# Set to 0 for multi-sequence profiles so vLLM does not over-reserve ~3.8 GiB for CUDA graphs (automatic in multi).
#VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=1
# Built-in vLLM reasoning parser for Nemotron 3.5 `<think>...</think>` blocks.
#REASONING_PARSER=nemotron_v3
# Extra flags appended to `vllm serve` (e.g. custom reasoning parser plugin).
#EXTRA_ARGS=

# --- the container (read by compose, not by vLLM) --------------------------------------------------------------------
# Host directory for Hugging Face weights and FlashInfer/b12x JIT caches. Unset, a named docker volume.
#CACHE_DIR=/srv/vllm/bolt-cache
# Shutdown grace period for docker compose down. Unset, compose's 30s.
#STOP_GRACE=30s
# Override the engine image (same digest conventions as compose.yaml). Unset, the pinned vLLM image.
#VLLM_IMAGE=
