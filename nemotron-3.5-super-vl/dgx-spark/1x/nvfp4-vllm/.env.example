# Nemotron 3.5 Super VL 120B-A12B NVFP4 on 1× or 2× DGX Spark (GB10, 128 GB): 1M context, DFlash LiLiCorr drafter.
# Copy to .env next to compose.yaml. Ready to boot 1× DGX Spark (`PROFILE=1spark`) as-is.
# For 2× DGX Spark (TP=2), set HEAD, IFACE, NODE_RANK, and TP2_PROFILE below and run `docker compose -f compose.tp2.yaml up -d`.

# --- the model -------------------------------------------------------------------------------------------------------
# Hugging Face repo id (fetched into CACHE_DIR on first boot) or a mounted local path.
MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4
# Pinned Hugging Face commit of MODEL (matches kindling.json weights_commit). Clear when pointing MODEL at a local dir.
MODEL_REVISION=ae1368329b1fc76b71534c5d04b87b35d9cc6e15
SERVED_MODEL_NAME=nemotron-3.5-super-vl
# OpenAI API host port (recipe standard: 8100).
PORT=8100
# Sent only to Hugging Face, for a gated or private repo or higher download rate limits.
#HF_TOKEN=

# --- 1-Spark profile (compose.yaml) ----------------------------------------------------------------------------------
# Preset for single-box DGX Spark (any individual knob below overrides the profile default):
#   1spark        : DFlash LiLiCorr drafter (7 tokens), 1 seq, 1M context, GMU 0.75 (model card recipe)
#   1spark-nospec : no drafter, 4 seqs, 1M context, GMU 0.75 (multi-stream concurrency on 1 box)
PROFILE=1spark

# --- 2-Spark TP=2 settings (compose.tp2.yaml) ------------------------------------------------------------------------
# TP=2 preset (use the same TP2_PROFILE and overrides on both ranks):
#   balanced : b12x MoE + linear, drafter 4 tokens, 4 seqs (best single-user balance: ~43-44 prose / 59-74 code, +14% prefill)
#   decode   : marlin MoE, drafter 4 tokens, 4 seqs (best 4-stream decode throughput: 95 prose / 155 code total)
#   prefill  : card default backends, drafter 7 tokens, 1 seq (fastest 8K/32K prefill: 4,216 / 3,968 tok/s)
#   nospec   : no drafter, 4 seqs
#TP2_PROFILE=balanced
# Rank 0 (serves API on PORT) or rank 1 (runs --headless). Start rank 0 first, then rank 1.
#NODE_RANK=0
# Rank 0 IP address on the direct high-speed (RoCE) link.
#HEAD=192.0.2.1
# High-speed network interface name on this box (e.g. enp1s0f0np0). Used for NCCL, Gloo, and auto-detecting VLLM_HOST_IP.
#IFACE=enp1s0f0np0
# Optional explicit IP for this box on IFACE; unset, resolved automatically from IFACE at container start.
#VLLM_HOST_IP=
# Distributed rendezvous port between rank 0 and rank 1.
#MASTER_PORT=29511
#NCCL_DEBUG=WARN

# --- individual knob overrides (leave commented to use PROFILE / TP2_PROFILE defaults) -------------------------------
# Maximum concurrent sequences (1 for 1spark/prefill, 4 for 1spark-nospec/balanced/decode; set 16 for c10 concurrency).
#MAX_NUM_SEQS=1
# Kept at 0.75 on purpose to leave unified memory headroom for DGX OS and the vision encoder.
#GPU_MEMORY_UTILIZATION=0.75
# Prefill chunk size.
#MAX_NUM_BATCHED_TOKENS=8192
# DFlash LiLiCorr drafter repo id or local path. Set empty (DRAFTER=) to disable speculative decoding.
#DRAFTER=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B-NVFP4-LiLiCorr
# Pinned Hugging Face commit of DRAFTER. Clear when pointing DRAFTER at a local directory.
#DRAFTER_REVISION=292bf1efc06ba39567da7351f2ad7a522afa3959
# Draft tokens per verify step (7 on 1-Spark card recipe; 4 on tuned TP2 profiles).
#NUM_SPECULATIVE_TOKENS=7
# TP2 backend overrides (balanced sets b12x for both; decode sets MOE_BACKEND=marlin).
#MOE_BACKEND=
#LINEAR_BACKEND=
# Extra flags appended to `vllm serve`.
#EXTRA_ARGS=

# --- the container (read by compose, not by vLLM) --------------------------------------------------------------------
# Host directory for Hugging Face weights and FlashInfer/b12x JIT caches. Unset, a named docker volume.
#CACHE_DIR=/srv/vllm/super-vl-cache
# Shutdown grace period for docker compose down. Unset, compose's 30s.
#STOP_GRACE=30s
# Override the engine image (same digest conventions as compose.yaml). Unset, the pinned vLLM image.
#VLLM_IMAGE=
