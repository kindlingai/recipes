# Qwen3-VL-Embedding-2B (exlr8 K4) on one DGX Spark (GB10) at TP=1.
# Copy to .env next to compose.yaml. Ready to boot as-is: first boot fetches 1.33 GB from Hugging Face,
# verifies all 54 SHA-256 + XXH64 checksums, and serves /v1/embeddings on http://127.0.0.1:8100/v1.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=embed
# Pinned Hugging Face commit of the calibrated exlr8-v2 K4 release (1.33 GB, 2048-dim, MRL 64..2048, DeepStack vision).
MODEL=https://huggingface.co/kindlingai/Qwen3-VL-Embedding-2B-exlr8-k4@7f98ec7913b7bd4844b8e7da8015f1a77a13ba1f
# Sent only to Hugging Face, for a gated or private repo or higher download rate limits.
#HF_TOKEN=

# --- topology --------------------------------------------------------------------------------------------------------
TP=1
PEERS=127.0.0.1
PORT=8100

# --- tuned settings --------------------------------------------------------------------------------------------------
# Dynamic token-budgeted batch size (g6embed --max-batched-tokens) and max input sequence length (--max-model-len).
# Default 16384 uses ~2.61 GiB GPU memory total (1,173 MiB weights + 1,154 MiB workspace).
CAP=16384
MAX_MODEL_LEN=16384
READY_TMO=600
# Skip load-time XXH64 block checksum verification (default 0: full verification adds <0.1 s).
#NOHASH=0
# Extra g6embed CLI flags (e.g. --weight-mode bf16 for BF16-dequantized cuBLAS parity debugging).
#EXTRA_ARGS=

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# Optional host directories (owned by uid 1000) for the model cache and logs/state. Unset, named docker volumes.
#GR8_CACHE=/srv/gr8/cache
#GR8_HOME=/srv/gr8/home
# Shutdown grace period. Unset, compose's 30s.
#GR8_STOP_GRACE=30s
# Override the pinned gr8 image. Unset, compose.yaml's pinned digest.
#GR8_IMAGE=
