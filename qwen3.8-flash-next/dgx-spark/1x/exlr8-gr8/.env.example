# Qwen3.8-Flash-Next on one DGX Spark at TP=1 (full 256K context per chat, 6 concurrent chats on K3 / 4 on K4,
# auto-loaded DFlash + MTP=3 hybrid drafting, and O_DIRECT SSD KV prefix cache).
# Copy to .env next to compose.yaml. Compose passes each line into the container, where gr8's launcher reads it as an
# option (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option and its default).
#
# Ready to boot as-is on a single box. The active lines are the exact settings the README's K3 (bit300) numbers were
# measured with; for K4 (bit400), set VARIANT=bit400 and SESS=4 (or SESS=5 with MTP=0 and GR8_QW38_NO_MTP=1).

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=qw38
# The release, pinned to the Hugging Face commit (K2/K3/K4 experts, PLE NVMe rowstore, DFlash drafter, opt-in BF16
# vision tower). The model cache is keyed by commit, so a new commit changes nothing here until this line moves.
MODEL=https://huggingface.co/kindlingai/Qwen3.8-Flash-Next-exlr8@9eac06b31c42a4e3a2811823d66e3dddf13ac019
# Width profile on 1x Spark at full native 262,144-token context:
#   bit300 (default, K3, 3.00 bpw, SESS=6): 114.2 code / 58.5 prose / 140.8 structured / 138.4 at 6 streams; 1.57M KV rows.
#   bit400 (K4, 4.00 bpw, set SESS=4):      108.3 code / 56.6 prose / 130.8 structured / 105.7 at 4 streams; 1.05M KV rows, 0.0046 mean KL.
VARIANT=bit300
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- single-box topology ---------------------------------------------------------------------------------------------
TP=1
PEERS=127.0.0.1

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A local NVMe host directory for the model (~164 GB for bit300, ~179 GB for bit400) + 32 GB SSD KV cache, owned by uid
# 1000. Keep on local NVMe (not NFS/HDD) for low-latency Layer-1 PLE reads and O_DIRECT SSD KV. Unset, a named volume.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000. Unset, a named docker volume.
#GR8_HOME=/srv/gr8/home

# --- full 256K per-chat context & tuned TP=1 settings ----------------------------------------------------------------
READY_TMO=1800
# Qwen3.8-Flash-Next allocates a dedicated CAP-token KV slab per session slot (per_slot_pool=True).
# CAP=262208, MAX_MODEL_LEN=262144 gives every active chat the model's full native 256K context:
#   bit300 (default): SESS=6 -> 6 dedicated 262K chats (1,573,248 total KV rows, 5.59 GiB min free).
#   bit400 (K4):      SESS=4 -> 4 dedicated 262K chats (1,048,832 total KV rows, 4.55 GiB min free).
#                     (Or SESS=5 with MTP=0 and GR8_QW38_NO_MTP=1 for 1.31M KV rows and 8.01 GiB min free.)
CAP=262208
MAX_MODEL_LEN=262144
SESS=6
# Hybrid speculative decoding: gr8 auto-discovers drafter/dflash.q4_0.pack for solo c1 decode (up to 7 tokens/round),
# while Layer-48 MTP=3 accelerates multi-stream concurrency (c2..c6). Set GR8_QW38_DFL=0 in EXTRA_ENV to disable DFlash.
MTP=3
# Prefix reuse backed by a 32 GiB O_DIRECT SSD KV store (0 GiB extra RAM, ~1.25M cached tokens on NVMe, 0.56 s 128K
# restore). Add persist=on,keep=sessions and GR8_STOP_GRACE=150s if you want sessions to survive container restarts.
REUSE=1
KV_STORE=ssd:/var/lib/gr8/cache/kv,size=32G,keep=all
# 1 GiB host LRU cache for the 102.4 GB NVMe PLE rowstore.
# Add GR8_QW38_VISION=1 here to enable multimodal image input (+898 MB VRAM; use SESS=5 on bit300 or SESS=3 on bit400).
# Add GR8_QW38_NO_MTP=1 (with MTP=0) to free 5.2 GB VRAM for +1 full 262K slot (SESS=7 on bit300 / SESS=5 on bit400).
EXTRA_ENV="GR8_QW38_PLE_CACHE_MIB=1024"
