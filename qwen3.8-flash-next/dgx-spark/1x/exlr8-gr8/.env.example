# Qwen3.8-Flash-Next on one DGX Spark at TP=1 (139K context per chat, 8 concurrent chats, MTP=3).
# Copy to .env next to compose.yaml. Compose passes each line into the container, where gr8's launcher reads it as an
# option (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option and its default).
#
# Ready to boot as-is on a single box. The active lines are the exact settings the README's K3 (bit300) numbers were
# measured with; switch VARIANT=bit400 for the measured K4 quality preset.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=qw38
# The release, pinned to the Hugging Face commit (v0.2: K2/K3/K4 experts, PLE NVMe rowstore, opt-in BF16 vision tower)
# the README's numbers were measured with. The model cache is keyed by commit, so a new commit changes nothing here
# until this line moves.
MODEL=https://huggingface.co/kindlingai/Qwen3.8-Flash-Next-exlr8@4943478fdd54d8a59f2f9824b2389799e79f564b
# Width profile (both fit 1x Spark at CAP=139264, SESS=8):
#   bit300 (default, K3, 3.00 bpw): 83.0 code / 61.5 prose / 155.2 at 8 streams; 45.4 GB experts, 0.0124 mean KL.
#   bit400 (K4, 4.00 bpw):          78.4 code / 55.1 prose / 140.6 at 8 streams; 60.5 GB experts, 0.0046 mean KL.
VARIANT=bit300
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- single-box topology ---------------------------------------------------------------------------------------------
TP=1
PEERS=127.0.0.1

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A local NVMe host directory for the model (~163 GB for bit300, ~178 GB for bit400), owned by uid 1000.
# Keep on local NVMe (not NFS/HDD) for low-latency Layer-1 PLE reads. Unset, a named docker volume.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000. Unset, a named docker volume.
#GR8_HOME=/srv/gr8/home

# --- 139K per-chat context & tuned TP=1 settings (measured on gr8 v1.2.0) --------------------------------------------
READY_TMO=1800
# Qwen3.8-Flash-Next allocates a dedicated CAP-token KV slab per session slot (per_slot_pool=True).
# CAP=139264, SESS=8 gives 8 concurrent chats up to 139,200 tokens each (1,114,112 total KV rows), fitting both bit300
# and bit400 on a single 128 GB DGX Spark.
CAP=139264
MAX_MODEL_LEN=139200
SESS=8
# Layer-48 MTP speculative drafting (0..5):
#   3 (default): best overall balance (83.0 code / 61.5 prose / 87.4 structured / 155.2 at 8 streams on bit300).
#   4:           faster on code/structured/counting (89.5 code / 97.2 structured / 99.1 counting, 57.7 prose on bit300).
MTP=3
# 4 GiB host LRU cache for the 102.4 GB NVMe PLE rowstore.
# Add GR8_QW38_VISION=1 here to enable multimodal image input (+898 MB VRAM for the 27-layer BF16 ViT).
EXTRA_ENV="GR8_QW38_PLE_CACHE_MIB=4096"

# --- optional: prefix reuse & persistent SSD KV store ----------------------------------------------------------------
# Uncomment REUSE=1 to cache and reuse repeated prompt prefixes across requests.
#REUSE=1
# Uncomment to save prefix/session state to SSD (requires GR8_STOP_GRACE=150s for orderly persist=on shutdown).
#KV_STORE=ssd:/var/lib/gr8/cache/kv,size=200G,persist=on,keep=sessions
#GR8_STOP_GRACE=150s
