# Qwen3.8-Flash-Next on two DGX Sparks at TP=2 (full native 256K context per chat, 8 concurrent chats, MTP=3).
# Copy to .env next to compose.yaml on both boxes: the same file on both. Compose passes each line into the container,
# where gr8's launcher reads it as an option (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option and its
# default).
#
# Set PEERS (and IPS / IPS2 if pinning explicit ConnectX-7 RoCE rail addresses). The other active lines are the exact
# settings the README's K3 (bit300) numbers were measured with; switch VARIANT=bit400 for the measured K4 preset.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=qw38
# The release, pinned to the Hugging Face commit (v0.2: K2/K3/K4 experts, PLE NVMe rowstore, opt-in BF16 vision tower)
# the README's numbers were measured with. The model cache is keyed by commit, so a new commit changes nothing here
# until this line moves.
MODEL=https://huggingface.co/kindlingai/Qwen3.8-Flash-Next-exlr8@4943478fdd54d8a59f2f9824b2389799e79f564b
# Width profile (both fit 2x Spark at full native 256K context CAP=262208, SESS=8 with >50 GB free RAM/box):
#   bit300 (default, K3, 3.00 bpw): 126.8 code / 89.2 prose / 254.5 at 8 streams; 22.7 GB experts/box, 0.0124 mean KL.
#   bit400 (K4, 4.00 bpw):          122.1 code / 86.9 prose / 234.1 at 8 streams; 30.3 GB experts/box, 0.0046 mean KL.
VARIANT=bit300
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- the boxes -------------------------------------------------------------------------------------------------------
# The LAN address of both boxes, in rank order, the same line on both boxes. The first is the head (OpenAI API on
# port 8100).
PEERS=192.0.2.1,192.0.2.2
TP=2
# Optional: explicit ConnectX-7 RoCE v2 rail addresses (rank 0, rank 1). When unset, gr8 discovers RoCE links from
# PEERS. Dual-rail (IPS + IPS2) delivers the full 400 Gbps aggregate link bandwidth between two direct-cabled or
# switch-connected Sparks (used for the README's measured numbers).
#IPS=198.51.100.1,198.51.100.2
#IPS2=203.0.113.1,203.0.113.2
# Per box: this box's LAN address, when PEERS holds more than one address of this box.
#NODE_IP=

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A local NVMe host directory for this box's part of the model (~141 GB for bit300, ~148 GB for bit400), owned by
# uid 1000. Keep on local NVMe (not NFS/HDD) for low-latency Layer-1 PLE reads. Unset, a named docker volume.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000. Unset, a named docker volume.
#GR8_HOME=/srv/gr8/home

# --- full native 256K per-chat context & tuned TP=2 settings (measured on gr8 v1.2.0) --------------------------------
READY_TMO=1800
# Qwen3.8-Flash-Next allocates a dedicated CAP-token KV slab per session slot (per_slot_pool=True).
# CAP=262208, SESS=8 gives 8 concurrent chats up to the full native 262,144 tokens each (2,097,664 total KV rows).
CAP=262208
MAX_MODEL_LEN=262144
SESS=8
# Layer-48 MTP speculative drafting (0..5).
MTP=3
# 4 GiB host LRU cache for the 102.4 GB NVMe PLE rowstore.
# Add GR8_QW38_VISION=1 here to enable multimodal image input (+898 MB VRAM per box for the 27-layer BF16 ViT).
EXTRA_ENV="GR8_QW38_PLE_CACHE_MIB=4096"

# --- optional: prefix reuse & persistent SSD KV store ----------------------------------------------------------------
# Uncomment REUSE=1 to cache and reuse repeated prompt prefixes across requests.
#REUSE=1
# Uncomment to save prefix/session state to SSD (requires GR8_STOP_GRACE=150s for orderly persist=on shutdown).
#KV_STORE=ssd:/var/lib/gr8/cache/kv,size=200G,persist=on,keep=sessions
#GR8_STOP_GRACE=150s
