# Path to cloned kindlingai/gr8 repo (built with MODEL=qw38 GR8_NR=1 ARCH=120a)
GR8_DIR=./gr8

# Path to downloaded kindlingai/Qwen3.8-Flash-Next-exlr8 weights
MODEL_DIR=./models/Qwen3.8-Flash-Next-exlr8

# CUDA architecture: 120a for RTX 5090 / RTX PRO 6000 (Blackwell), 121a for GB10
ARCH=120a

# Serving settings
HOST=127.0.0.1
PORT=8100
SERVED_MODEL_NAME=qwen3.8-flash-next
CAP=40960
PREFILL=13312
MTP=4
VRAM_RESERVE_MIB=1920

# Optional: override PLE path (omit to use $MODEL_DIR/ple/exlr8-ple-L001.bin automatically)
PLE_PATH=

# Optional: static hot-expert warmup profile path
EXPERT_PROFILE=
