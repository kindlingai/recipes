# Qwen3.8-Flash-Next K3 (bit300) on one RTX 5090 (32 GB VRAM + 96-128 GB DDR5 + AVX-512 CPU).
# Copy to .env next to compose.yaml. Compose passes each line into the container, where gr8's launcher reads it as an
# option (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option and its default).
#
# Ready to boot as-is on a single RTX 5090 box with the pinned gr8 v1.3.1 linux/amd64 sm_120a image. The active
# lines match the Strata single-GPU settings used for the README's Results numbers.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=qw38
# Hugging Face release (auto-fetches bit300 into GR8_CACHE on first boot). To boot from a pre-downloaded local model
# directory mounted read-only, uncomment MODEL_DIR below and set MODEL=/var/lib/gr8/model.
MODEL=https://huggingface.co/kindlingai/Qwen3.8-Flash-Next-exlr8
# K3 width profile (3.00 bpw, ~46.7 GB pinned host RAM for routed experts). With a local read-only model mount you can
# also pass an explicit manifest path (e.g. VARIANT=/var/lib/gr8/model/manifests/exlr8-manifest-bit300.json).
VARIANT=bit300
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- topology --------------------------------------------------------------------------------------------------------
TP=1
PEERS=127.0.0.1

# --- tuned settings --------------------------------------------------------------------------------------------------
# Single-GPU Blackwell Strata mode (hot routed experts in VRAM + cold experts in pinned host RAM / AVX-512 CPU MoE).
READY_TMO=1800
CAP=40960
MAX_MODEL_LEN=40960
SESS=1
# INT4 MTP=4 speculative drafter.
MTP=4
REUSE=1
ALLOW_THINKING_OFF=1
# Engine environment knobs for Strata mode and fast host-RAM weight loading:
#   GR8_QW38_STRATA=1              enable adaptive VRAM hot-expert cache + pinned host-RAM backing + AVX-512 CPU MoE
#   GR8_QW38_VRAM_RESERVE_MIB=1920 leave 1,920 MiB free VRAM headroom after sizing the hot-expert cache pool
#   GR8_LOAD_THREADS=8 / GR8_LOAD_CHUNK_MB=32 / GR8_LOAD_MERGE_KB=0  NVMe -> host RAM loader tuning
# Optional additions inside EXTRA_ENV:
#   GR8_QW38_EXPERT_PROFILE=/var/lib/gr8/model/<profile>  static hot-expert warmup profile path
#   GR8_QW38_EXPERT_CACHE_SLOTS=<n>                       override auto-sized VRAM hot-expert cache slots
#   GR8_QW38_DFL=0                                        force pure MTP=4 if a DFlash drafter pack is present
EXTRA_ENV="GR8_QW38_STRATA=1 GR8_QW38_VRAM_RESERVE_MIB=1920 GR8_LOAD_THREADS=8 GR8_LOAD_CHUNK_MB=32 GR8_LOAD_MERGE_KB=0"
# Prefill chunk budget (tokens). Append `--ple /var/lib/gr8/model/<file>` here to override the default Layer-1 PLE
# rowstore (`$MODEL/ple/exlr8-ple-L001.bin`, e.g. with a compact GGUF PLE inside the read-only MODEL_DIR mount).
EXTRA_ARGS="--prefill 13312"

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# Optional pre-downloaded local model directory (weights, manifests/, ple/), mounted read-only at /var/lib/gr8/model.
# Uncomment and set MODEL=/var/lib/gr8/model above to boot from an existing local download. Unset, a named volume.
#MODEL_DIR=./models/Qwen3.8-Flash-Next-exlr8
# A local NVMe host directory for the model cache (~165 GB for bit300), owned by uid 1000. Keep on fast local NVMe
# (not NFS/HDD) for low-latency Layer-1 PLE reads. Unset, a named docker volume.
#GR8_CACHE=/srv/gr8/cache
# A host directory for logs and state, owned by uid 1000. Unset, a named docker volume.
#GR8_HOME=/srv/gr8/home
# Longer shutdown grace when a persistent KV_STORE (persist=on) flushes sessions on stop. Unset, compose's 30s.
#GR8_STOP_GRACE=150s
# Override the gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
