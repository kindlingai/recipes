# Sage-S2.1-Flash on two DGX Sparks at TP=2 (k4, int4 KV, 256K context, 4 sessions).
# Copy to .env next to compose.yaml on both boxes, the same file on each. Compose passes each line into the container,
# where gr8's launcher reads it as an option (`docker compose exec gr8 /opt/gr8/gr8 knobs` lists every option).
#
# Set PEERS (and IPS / IPS2), or comment out PEERS and uncomment MENTAT=localhost. The active lines are the exact
# default speed-preset settings the README's Results numbers were measured with.

# --- the model -------------------------------------------------------------------------------------------------------
GR8_MODEL=glm53f
# The exlr8 k4 release, pinned to the Hugging Face commit the README's numbers were measured with.
MODEL=https://huggingface.co/kindlingai/sage-s2.1-flash-exlr8-k4@e55da4682c090821efcac7f5fb85622cb06d1c54
VARIANT=k4
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- topology --------------------------------------------------------------------------------------------------------
TP=2
# The two boxes' 10G LAN addresses, head first, identical on both boxes. The head serves the OpenAI API on port 8100.
PEERS=192.0.2.1,192.0.2.2
# Each box's ConnectX address on PCIe root 1 (IPS) and PCIe root 2 (IPS2), in PEERS order. Unset, each box finds its own.
#IPS=10.0.0.1,10.0.0.2
#IPS2=10.0.1.1,10.0.1.2
# Mentat auto-discovery: comment out PEERS/IPS/IPS2 above and uncomment MENTAT=localhost below (gr8 rejects both).
#MENTAT=localhost
GROUP=gr8-sage-2x

# --- tuned settings (default speed preset, measured serve) -----------------------------------------------------------
KV_FORMAT=int4
SESS=4
CAP=262208
MAX_MODEL_LEN=262144
# Bit-exact shared waterfill MTP=2 drafting (no DFlash2 drafter).
MTP=2
S2_SHARED_WATERFILL=1
DFLASH=0
# Aligned prompt checkpoint cache on disk + spare RAM (mounted read-only by compose.yaml).
FLASH_CACHE=aligned
KV_STORE=@/etc/gr8/kv-store.yaml
# Reply length and undeclared tool-call handling.
DEFAULT_MAX_TOKENS=32768
UNDECLARED_TOOL_CALLS=emit
#DEFAULT_THINK_END_BOOST=
#DEFAULT_THINKING_BUDGET=0
#DEFAULT_PRESENCE_PENALTY=0

# --- alternative presets (override active lines above; README.md, "Settings") ----------------------------------------
# Context preset (8 sessions with experimental context-parallel KV):
#SESS=8
#EXTRA_ENV=GR8_CP=1
#
# Quality baseline (strict MTP=1):
#MTP=1
#S2_SHARED_WATERFILL=0

# --- optional features (EXTRA_ENV holds one space-separated line) ----------------------------------------------------
# Vision (untested with this recipe; release includes 1.13 GB dense/vision-bf16.safetensors):
#EXTRA_ENV=GR8_GLM53F_VISION=1
#
# Compact expert copies (72.8 GiB/box; run `docker compose run --rm gr8 prepare` once on both boxes first):
#EXTRA_ENV=GR8_LOAD_COMPACT=/var/lib/gr8/cache/compact-tp2 GR8_LOAD_MERGE_KB=1

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A host directory for this box's part of the model (~82 GiB at TP=2) and prompt cache (up to 64 GB), owned by uid 1000.
# Unset, a named docker volume.
#GR8_CACHE=/srv/sage-2x/cache
# A host directory for logs and state, owned by uid 1000. Unset, a named docker volume.
#GR8_HOME=/srv/sage-2x/home
# Longer shutdown grace when flushing large persistent KV state. Unset, compose's 30s.
#GR8_STOP_GRACE=150s
# Override the gr8 image (same digest conventions as compose.yaml). Unset, the pinned image.
#GR8_IMAGE=
