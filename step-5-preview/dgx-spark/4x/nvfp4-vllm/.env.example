# Step-5 Preview NVFP4 on 4x DGX Spark (TP=4, staged FP8 KV, MTP3, 576K default window).
# Copy to .env next to compose.yaml on each of the four compute nodes and set NODE_RANK,
# NODE0..NODE3, NETWORK_IFACE, and RDMA_HCA for your isolated cluster.
#
# Ready to boot b5-fp8 once weights, read-only NFS mounts, and /srv/step5/model symlinks are in
# place (see README.md). Active profile settings match the measured Results tables.

# --- profile -------------------------------------------------------------------------------------
# Profiles set STEP5_FP8KV, KV_DTYPE, MAXLEN, FP8KV_BLOCKS, GMU, and
# VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS together:
#   b5-fp8        576K window (589824), 40000 FP8 blocks, GMU 0.86, graph estimate 0 (default)
#   b4-fp8        442K window (442368), 30000 FP8 blocks, GMU 0.85, graph estimate 1 (safer FP8)
#   b4-bf16-192k  192K window (196608), BF16 KV, GMU 0.85, graph estimate 1 (safe BF16 option)
#   b4-bf16-256k  256K window (262144), BF16 KV, GMU 0.86, graph estimate 1 (not benchmarked)
#   custom        provide explicit STEP5_FP8KV, KV_DTYPE, MAXLEN, GMU (and FP8KV_BLOCKS if FP8)
PROFILE=b5-fp8

# --- topology ------------------------------------------------------------------------------------
# Set NODE_RANK on each node: 0 = head (serves OpenAI API on API_PORT), 1..3 = headless workers.
NODE_RANK=0
# Documentation placeholders; replace with your own isolated cluster addresses.
NODE0=192.168.50.11
NODE1=192.168.50.12
NODE2=192.168.50.13
NODE3=192.168.50.14
# Optional explicit bind IP for this rank; unset uses NODE0..NODE3 selected by NODE_RANK.
#VLLM_HOST_IP=
NETWORK_IFACE=eth0
# Example HCA names only: replace with the two active fabric rails on each node.
RDMA_HCA=mlx5_0,mlx5_1
NCCL_CROSS_NIC=1
NCCL_MIN_NCHANNELS=2
NCCL_MAX_NCHANNELS=2
API_PORT=8100
MASTER_PORT=29511

# --- storage and host scripts --------------------------------------------------------------------
# Use identical absolute paths on all four nodes so /srv/step5/model symlinks resolve inside Docker.
STEP5_ROOT=/srv/step5
CACHE_DIR=/var/cache/step5
SOURCE_DIR=/mnt/model-source
NFS_CLIENT_CIDR=192.168.50.0/24
SSH_USER=
MODEL_REVISION=bc246cc2848e17b37f377eda8fd825c5b3018d1f
# Optional host page-cache workaround helper (scripts/drop-page-cache.sh, run on host if needed).
DROP_PAGE_CACHE=1

# --- tuned settings (shared across profiles, or overrides for PROFILE=custom) --------------------
MAXSEQ=8
BATCH_TOKENS=4096
STEP5_DENSE=1
LMONLY=1
SPEC_TOKENS=3
# Uncomment only when using PROFILE=custom or overriding a single profile parameter:
#STEP5_FP8KV=1
#KV_DTYPE=fp8_e4m3
#MAXLEN=589824
#FP8KV_BLOCKS=40000
#GMU=0.86
#VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0
#FP8KV_DIR=

# --- the container (read by compose.yaml) --------------------------------------------------------
CONTAINER_PREFIX=step5
# Shutdown grace period for docker compose down. Unset, compose's 30s.
#STOP_GRACE=30s
# Override the pinned vLLM image (always pin by @sha256:<digest>). Unset, compose.yaml's digest pin.
#VLLM_IMAGE=

# --- legacy benchmark script helpers -------------------------------------------------------------
BENCH_HOSTS="$NODE0,$NODE1,$NODE2,$NODE3"
CLIENT_LABEL=client
