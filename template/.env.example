# <Model> on <count>× <hardware> (<headline: context per chat, concurrency, drafting, cache>).
# Copy to .env next to compose.yaml. Compose passes each line into the container, where the launcher reads it as an
# option (`docker compose exec engine <engine> knobs` lists every option and its default).
#
# Ready to boot as-is. The active lines are the exact settings the README's Results numbers were measured with.

# --- the model -------------------------------------------------------------------------------------------------------
MODEL=<quantised release URL, pinned to the Hugging Face commit>
# Sent only to Hugging Face, for a gated or private repo.
#HF_TOKEN=

# --- topology --------------------------------------------------------------------------------------------------------
TP=<n>
PEERS=127.0.0.1

# --- tuned settings --------------------------------------------------------------------------------------------------
# <Every knob the README's numbers were measured with, one per line, with a comment on what it does and what the
#    alternatives cost. Quantised-context and session knobs first, then speculative decoding, then caches.>
MAX_MODEL_LEN=<n>
SESS=<n>

# --- tuned presets ---------------------------------------------------------------------------------------------------
# Where the engine has presets, name them; TUNE expands to the preset's knobs.
#TUNE=balanced

# --- the container (read by compose, not by the launcher) ------------------------------------------------------------
# A fast local NVMe host directory for the model + cache, owned by the image's uid. Unset, a named docker volume.
#CACHE_DIR=/srv/<engine>/cache
# A host directory for logs and state. Unset, a named docker volume.
#STATE_DIR=/srv/<engine>/home
# Longer shutdown grace when sessions persist across restarts. Unset, compose's 30s.
#STOP_GRACE=150s
# Override the engine image (same digest conventions as compose.yaml). Unset, the pinned image.
#ENGINE_IMAGE=
